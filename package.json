{
  "name": "engineering-portal",
  "version": "1.0.0",
  "packageManager": "pnpm@10.28.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "payload generate:importmap && cross-env PAYLOAD_DROP_DATABASE=false next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "next dev",
    "dev:prod": "pnpm build && pnpm start",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "ii": "pnpm --ignore-workspace install",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "payload": "payload",
    "reinstall": "pnpm --ignore-workspace install",
    "start": "next start",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/admin-bar": "^3.87.1",
    "@payloadcms/db-postgres": "^3.87.1",
    "@payloadcms/live-preview-react": "^3.87.1",
    "@payloadcms/next": "3.87.1",
    "@payloadcms/plugin-form-builder": "^3.87.1",
    "@payloadcms/plugin-nested-docs": "^3.87.1",
    "@payloadcms/plugin-redirects": "^3.87.1",
    "@payloadcms/plugin-search": "^3.87.1",
    "@payloadcms/plugin-seo": "^3.87.1",
    "@payloadcms/richtext-lexical": "^3.87.1",
    "@payloadcms/ui": "3.87.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-sitemap": "^4.2.3",
    "payload": "3.87.1",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "postcss": "^8.4.38",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}